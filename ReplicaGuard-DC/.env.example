# ─── Coordinator ────────────────────────────────────────────────────────────
COORDINATOR_PORT=4100

# How often each storage node sends a heartbeat (ms)
HEARTBEAT_INTERVAL_MS=5000

# How often the coordinator checks heartbeat timestamps (ms)
HEARTBEAT_CHECK_INTERVAL_MS=5000

# How long with no heartbeat before a node is marked DEAD (ms)
FAILURE_TIMEOUT_MS=15000

# How often the recovery engine scans for under-replicated files (ms)
RECOVERY_SCAN_INTERVAL_MS=10000

# Number of replicas to maintain per file
REPLICATION_FACTOR=3

# Maximum allowed upload size in bytes (default 50 MB)
MAX_FILE_SIZE_BYTES=52428800

# Pino log level: trace | debug | info | warn | error
LOG_LEVEL=info

# ─── Storage Node (set per-process) ─────────────────────────────────────────
NODE_ID=node-1
PORT=4101
STORAGE_DIR=storage/node-1
COORDINATOR_URL=http://localhost:4100
# REQUIRED before using account authentication outside a local demo: set a long random secret.
AUTH_SECRET=replace-with-a-long-random-secret-before-use
# Optional: set true only before creating the FIRST account to make it admin.
BOOTSTRAP_FIRST_USER_ADMIN=false
